    "2aq-kN-Stu.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"1. 打开系统设置\\n2. 点击 \\\"扩展\\\"\\n3. 选择 \\\"Xcode Source Editor\\\"\\n4. 打开 “Xcod插件”前面的开关\\n5. 重启Xcode\"; ObjectID = \"2aq-kN-Stu\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1. 打开系统设置\n2. 点击 \"扩展\"\n3. 选择 \"Xcode Source Editor\"\n4. 打开 “Xcod插件”前面的开关\n5. 重启Xcode"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 打开系统设置\n2. 点击 \"扩展\"\n3. 选择 \"Xcode Source Editor\"\n4. 打开 “Xcod插件”前面的开关\n5. 重启Xcode"
          }
        }
      }
    },
