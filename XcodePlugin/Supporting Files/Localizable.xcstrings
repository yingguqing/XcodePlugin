      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用 count(where:)，代替 filter(_:).count。"
          }
        }
      }
    },
    "preferExplicitFalse": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用 == false，而不是前缀取反 !。"
          }
        }
