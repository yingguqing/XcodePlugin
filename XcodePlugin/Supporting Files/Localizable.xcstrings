      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用 contains，代替 filter(_:).isEmpty、first(where:) != nil 和 range(of:) != nil。"
