      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在等价情况下使用不透明的泛型参数 (some Protocol) 而不是带有约束的泛型参数 (T where T: Protocol 等)。同时支持标准库类型的主要关联类型，因此像 T where T: Collection, T.Element == Foo 的定义被更新为 some Collection<Foo>。"
          }
        }
      }
    },
